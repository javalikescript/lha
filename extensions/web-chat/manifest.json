{
  "name": "Web Chat",
  "description": "Chat interface for llama.cpp API integration",
  "dependencies": ["web-base"],
  "version": "1.0",
  "script": "../web-base/addon.lua",
  "schema": {
    "type": "object",
    "properties": {
      "href": {
        "title": "The LLM API path",
